<Window x:Class="IsoLaunch.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IsoLaunch"
        Height="400" Width="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="14" BorderBrush="#2E3542" BorderThickness="1" ClipToBounds="True" Background="#111318">
        <Grid>
            <!-- Splash Background Artwork -->
            <Image Source="pack://application:,,,/Assets/splash.png"
                   Stretch="UniformToFill"
                   Opacity="0.92"/>

            <!-- Subtle Dark Gradient Overlay for Text Readability -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#88111318" Offset="0.0"/>
                        <GradientStop Color="#AA111318" Offset="0.55"/>
                        <GradientStop Color="#EE0D1015" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content -->
            <Grid Margin="32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Center Logo + Title -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border CornerRadius="16" Width="88" Height="88" BorderBrush="#3B82F6" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,0,16">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="IsoLaunch"
                               FontSize="34" FontWeight="Bold"
                               Foreground="#F9FAFB"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Isolated Windows Application Instance Launcher"
                               FontSize="13.5"
                               Foreground="#CBD5E1"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading Bar -->
                <ProgressBar Grid.Row="1"
                             IsIndeterminate="True"
                             Height="4"
                             Width="260"
                             Foreground="#3B82F6"
                             Background="#1F2937"
                             BorderThickness="0"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,20"/>

                <!-- Required Attribution Footer -->
                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#D1D5DB">
                    <Run Text="Product of Darnok Technologies, Inc. "/>
                    <Hyperlink NavigateUri="https://darnok.online"
                               Foreground="#60A5FA"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="https://darnok.online"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
