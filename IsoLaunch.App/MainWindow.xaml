<Window x:Class="IsoLaunch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IsoLaunch — Isolated Application Instance Launcher"
        Height="740" Width="1120"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        Icon="pack://application:,,,/Assets/logo.png"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="40" Height="40" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" ClipToBounds="True" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="IsoLaunch" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Run multiple isolated instances of Antigravity, VS Code, browsers, and custom Windows apps"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Antigravity" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="QuickAddAntigravity_Click"/>
                    <Button Content="+ VS Code" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="QuickAddVsCode_Click"/>
                    <Button Content="+ Chrome" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="QuickAddChrome_Click"/>
                    <Button Content="+ New Profile" Style="{StaticResource PrimaryButton}" Click="NewProfile_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Two-Column Content -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Profile List -->
            <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Saved Profiles" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource DarkTextBox}"
                             Margin="0,0,0,12" ToolTip="Filter profiles by name or app"
                             TextChanged="SearchBox_TextChanged"/>

                    <ListBox x:Name="ProfilesListBox" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProfilesListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="card"
                                                    Background="{StaticResource BgCard}"
                                                    BorderBrush="{StaticResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                                    <Setter TargetName="card" Property="Background" Value="{StaticResource BgCardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="Background" Value="{StaticResource BgCardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <TextBlock Text="{Binding ProfileName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Left"/>
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding AppName}" FontSize="11" Foreground="#BFDBFE"/>
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding ExecutablePath}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,8"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Launch" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="12"
                                                Margin="0,0,6,0" Tag="{Binding}" Click="LaunchProfileCard_Click"/>
                                        <Button Content="Folder" Style="{StaticResource BaseButton}" Padding="8,4" FontSize="12"
                                                Margin="0,0,6,0" Tag="{Binding}" Click="OpenFolderCard_Click"/>
                                        <Button Content="Clone" Style="{StaticResource BaseButton}" Padding="8,4" FontSize="12"
                                                Margin="0,0,6,0" Tag="{Binding}" Click="CloneProfileCard_Click"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="12"
                                                Tag="{Binding}" Click="DeleteProfileCard_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Column: Profile Editor -->
            <Border Grid.Column="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitleText" Text="Profile Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Preset" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PresetComboBox" Height="34" FontSize="13" SelectionChanged="PresetComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Profile Name (e.g. Account1, Work)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ProfileNameBox" Style="{StaticResource DarkTextBox}" TextChanged="EditorField_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="App Display Name" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="AppNameBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Executable Path (.exe)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExecutablePathBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="2" Content="Browse..." Style="{StaticResource BaseButton}" Click="BrowseExecutable_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,12">
                            <StackPanel>
                                <TextBlock Text="Isolation Options" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="IsolatePathsCheck" Content="Isolate USERPROFILE, APPDATA &amp; LOCALAPPDATA" Style="{StaticResource DarkCheckBox}"/>
                                <CheckBox x:Name="PassUserDataDirCheck" Content="Pass --user-data-dir (Electron / Chromium)" Style="{StaticResource DarkCheckBox}"/>
                                <CheckBox x:Name="PassNewWindowCheck" Content="Pass --new-window (separate window instance)" Style="{StaticResource DarkCheckBox}"/>
                                <CheckBox x:Name="BypassKeyringCheck" Content="Bypass shared keyring via SSH_CONNECTION (Antigravity language_server.exe)" Style="{StaticResource DarkCheckBox}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Extra Arguments (optional)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ExtraArgsBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="Custom Environment Variables (one KEY=VALUE per line)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CustomEnvBox" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" Height="74"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <TextBlock Text="Isolated Sandbox Directory" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SandboxPreviewBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                 Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>

                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="Open Sandbox" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="OpenSelectedSandbox_Click"/>
                                <Button Content="Wipe Sandbox Data" Style="{StaticResource DangerButton}" Click="WipeSelectedSandbox_Click"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Save Profile" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="SaveProfile_Click"/>
                                <Button Content="Save &amp; Launch" Style="{StaticResource PrimaryButton}" Click="SaveAndLaunch_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar & Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready. Create or select a profile to launch an isolated instance."
                           FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="16,0">
                    <Run Text="Product of Darnok Technologies, Inc. "/>
                    <Hyperlink NavigateUri="https://darnok.online"
                               Foreground="#60A5FA"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="https://darnok.online"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="StorePathText" Grid.Column="2" FontSize="11" Foreground="#6B7280"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
